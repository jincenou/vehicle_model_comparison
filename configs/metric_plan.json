    },
    {
      "metric": "width_height_error",
      "enabled": false,
      "status": "research_specified_execution_not_qualified",
      "family": "legacy_size_diagnostic",
      "settings": {
        "formula": "s=Lref/Lpred; W_APE=100*abs(s*Wpred/Wref-1); H_APE analogous",
        "legacy_extent": "Gaussian-center quantiles .005/.995 in validated semantic axes",
        "unit": "percent",
        "cross_representation_status": "blocked_until_common_surface_extent_adapter",
        "absolute_scale_accuracy": false
      }
    },
    {
      "metric": "Box_extent_IoU",
      "enabled": false,
      "status": "research_specified_execution_not_qualified",
      "family": "legacy_size_diagnostic",
      "settings": {
        "formula": "prod(min(s*pred_extent,ref_extent))/(prod(s*pred_extent)+prod(ref_extent)-intersection)",
        "assumption": "same centre and semantic orientation; length-normalized",
        "legacy_extent": "Gaussian-center quantiles .005/.995",
        "cross_representation_status": "blocked_until_common_surface_extent_adapter",
        "is_surface_iou": false
      }
    },
    {
      "metric": "FID",
      "enabled": false,
      "status": "research_specified_execution_not_qualified",
      "family": "distribution_diagnostic",
      "settings": {
        "encoder": "pytorch-fid Inception pool3 2048",
        "feature_dimension": 2048,
